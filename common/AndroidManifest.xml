<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="yomikku.extension" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}">

        <meta-data
            android:name="yomikku.extension.class"
            android:value="${extClass}" />

        <meta-data
            android:name="yomikku.extension.nsfw"
            android:value="${nsfw}" />
    </application>
</manifest>
